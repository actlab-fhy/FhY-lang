op sigmoid<>(input float32 x) -> output float32 {
  return (1.0 / (1.0 + exp<>[](-(x))));
}
proc forward<>(input float32[n] x, param float32[m, n] W, param float32[m] b, output float32[m] y) {
  temp index[1:m:1] i;
  temp index[1:n:1] j;
  temp float32[m] FC_out;
  FC_out[i] = (sum<>[j]((W[i, j] * x[j])) + b[i]);
  y[i] = sigmoid<>[](FC_out[i]);
}
proc main<>(input float32[examples, n] X, param float32[m, n] W, param float32[m] b, output float32[examples, m] Y) {
  temp index[1:examples:1] e;
  temp index[1:n:1] i;
  temp index[1:m:1] j;
  temp float32[n] x;
  temp float32[m] y;
  forall (e) {
    x[i] = X[e, i];
    forward<>[](x, W, b, y);
    Y[e, j] = y[j];
  }
}